rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Profile Photos ──────────────────────────────────────────────────
    match /events/{eventId}/participants/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024   // max 5MB
        && request.resource.contentType.matches('image/.*');
      allow read: if true; 
    }

    // ─── Receipts (PDF) ──────────────────────────────────────────────────
    match /events/{eventId}/receipts/{fileName} {
      allow read: if true;  
      allow write: if request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // ─── Assets (logo, etc.) ─────────────────────────────────────────────
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only via Firebase Console
    }
  }
}
